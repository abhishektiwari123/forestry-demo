# API Keys for Pokemon AI Video Generator
# Copy this file to .env and fill in your actual API keys

# Anthropic Claude API (for AI orchestration)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API (for image generation)
GEMINI_API_KEY=your_gemini_api_key_here

# KIE.ai API (for video generation with Kling 2.5 Pro)
KIE_API_KEY=your_kie_api_key_here

# ElevenLabs API (for narration and sound effects)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Voice ID for David Attenborough-style narration
# Default uses ElevenLabs British narrator voice
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
