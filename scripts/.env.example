# Pokemon AI Video Generator - Environment Variables
# Copy this file to .env and fill in your API keys

# Anthropic API Key (for Claude orchestration)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI API Key (for Gemini 2.5 Flash image generation)
GOOGLE_API_KEY=your_google_api_key_here

# KIE.ai API Key (for Kling 2.5 Pro video animation)
KIE_API_KEY=your_kie_api_key_here

# ElevenLabs API Key (for TTS narration and sound effects)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Custom voice ID for narration (defaults to British narrator)
# ELEVENLABS_VOICE_ID=your_preferred_voice_id
